
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Produto {
  id         Int      @id @default(autoincrement())
  nome       String
  quantidade Int      @default(0)
  preco      Decimal  @db.Decimal(10, 2)
  criadoEm   DateTime @default(now())
}
